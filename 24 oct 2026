<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Grid Practice Tasks</title>

    <style>
           
/* Optional styling to make the boxes visible */
.box {
  background-color: #db3434;
  color: white;
  padding: 20px;
  text-align: center;
}
           .container {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 10px;
}
           .container {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
           .container {
  display: grid;
  grid-template-columns: 2fr 1fr;
  width: 600px;
}
    </style>
    
</head>
<body>

    <!-- Task 1: Your first grid -->
    <h2>Task 1</h2>
    <div class="grid-container-task1">
        <div class="box">1</div>
        <div class="box">2</div>
        <div class="box">3</div>
        <div class="box">4</div>
        <div class="box">5</div>
        <div class="box">6</div>
    </div>

    <!-- Task 2: Use repeat() -->
    <h2>Task 2</h2>
    <div class="grid-container-task2">
        <div class="box">1</div>
        <div class="box">2</div>
        <div class="box">3</div>
        <div class="box">4</div>
        <div class="box">5</div>
        <div class="box">6</div>
        <div class="box">7</div>
        <div class="box">8</div>
    </div>

    <!-- Task 3: Unequal columns -->
    <h2>Task 3</h2>
    <div class="grid-container-task3">
        <div class="box">1</div> (400px)
        <div class="box">2</div> (200px)
    </div>

    
</body>
</html>
